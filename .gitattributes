# Normalize line endings to LF in repo, checkout as-is on all platforms
* text=auto eol=lf

# Force binary for assets (no line-ending conversion)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.pdf binary
*.zip binary
*.safetensors binary
*.pt binary
*.onnx binary
*.tflite binary
